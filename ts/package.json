{
  "name": "library-api-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Library API - TypeScript / NestJS implementation of the shared contract",
  "license": "MIT",
  "author": "Aleksandar Stojanovic",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "$fastify"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "generate:contract": "openapi-typescript ../contract/openapi.yaml --default-non-nullable false -o src/generated/openapi.ts",
    "check:contract": "openapi-typescript ../contract/openapi.yaml --default-non-nullable false -o src/generated/openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "ci": "npm run check:contract && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  }
}
